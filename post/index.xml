        <item>
        <title>CH32V30x学习指南 - 从8051到RISC-V</title>
        <link>https://kun123.xyz/p/ch32v30x%E5%AD%A6%E4%B9%A0%E6%8C%87%E5%8D%97-%E4%BB%8E8051%E5%88%B0risc-v/</link>
        <pubDate>Fri, 27 Feb 2026 20:00:00 +0800</pubDate>
        
        <guid>https://kun123.xyz/p/ch32v30x%E5%AD%A6%E4%B9%A0%E6%8C%87%E5%8D%97-%E4%BB%8E8051%E5%88%B0risc-v/</guid>
        <description>&lt;script&gt;window.location.href=&#34;https://kun123.xyz/CH32V30x学习指南_从8051到RISCV.html&#34;;&lt;/script&gt;
